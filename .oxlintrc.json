{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "import", "vitest"],
  "ignorePatterns": ["dist", ".cache", "supabase", "src/shared/types/database.types.ts"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  },
  "overrides": [
    {
      "files": ["src/**"],
      "rules": {
        "import/no-relative-parent-imports": "error"
      }
    },
    {
      "files": ["src/shared/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/app", "@/app/**", "@/modules", "@/modules/**"],
                "message": "shared/ là tầng dùng chung, không được import từ app/ hay modules/."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/app/**"],
      "excludeFiles": ["src/app/dev/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^@/modules/[^/]+/",
                "message": "app/ chỉ import module qua cửa chính @/modules/<id>."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/modules/bill-split/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/app", "@/app/**", "@/modules/**", "!@/modules/bill-split", "!@/modules/bill-split/**"],
                "message": "Module chỉ được import từ shared/ và chính nó."
              }
            ]
          }
        ]
      }
    }
  ]
}
