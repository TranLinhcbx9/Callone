# Sao chép thành .env.local rồi điền giá trị.
# Local: chạy `npm run db:start` rồi `npm run db:status` để lấy URL và Publishable key.
# Production: Supabase Dashboard > Project Settings > API Keys, dùng publishable key (sb_publishable_...).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
